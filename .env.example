# Midscene e2e 所需的模型配置(npm run e2e)。
# 任一 OpenAI 兼容的视觉模型均可,例如智谱 GLM-4.6V:
MIDSCENE_MODEL_BASE_URL=""
MIDSCENE_MODEL_API_KEY=""
MIDSCENE_MODEL_NAME=""
MIDSCENE_MODEL_FAMILY=""

# e2e 目标页面地址(默认即 npm run dev 的地址)
# E2E_APP_URL="http://127.0.0.1:5173/"
# 样例数据位置(仓库不附带 DATA/,需本机提供 EDF 数据):
# E2E_FIXTURE_DIR="DATA/DATAFILE"
# E2E_FIXTURE_DAYS="20240724,20240725"
# 有头模式调试:E2E_HEADED=1
